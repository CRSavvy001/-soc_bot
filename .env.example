# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenGoesHere

# The chat ID that detected addresses get forwarded to (a group or channel
# the bot is a member/admin of). Use the /id command in that chat to find it.
TARGET_CHAT_ID=-1001234567890

# Optional: comma-separated list of chat IDs to watch for addresses.
# Leave empty to watch every chat the bot is added to.
SOURCE_CHAT_IDS=

# Optional: append a "From: <chat> • <user>" line to forwarded messages.
INCLUDE_SOURCE_INFO=true
